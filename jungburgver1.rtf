    font-family: 'Space Mono', monospace;\
    font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;\
    padding: 1rem 2.5rem; border: none; cursor: pointer;\
    align-self: flex-start;\
    transition: transform 0.2s, box-shadow 0.2s;\
  \}\
  .form-submit:hover \{ transform: translateY(-2px); box-shadow: 0 8px 24px rgba(212,255,0,0.2); \}\
\
  /* \uc0\u9472 \u9472 \u9472  FOOTER \u9472 \u9472 \u9472  */\
  footer \{\
    border-top: 1px solid var(--border);\
    padding: 3rem 5rem;\
    display: flex; align-items: center; justify-content: space-between;\
    background: var(--ink);\
  \}\
  .footer-logo \{ height: 36px; \}\
  .footer-copy \{\
    font-family: 'Space Mono', monospace;\
    font-size: 0.6rem; letter-spacing: 0.1em; color: var(--muted);\
  \}\
  .footer-links \{\
    display: flex; gap: 2rem; list-style: none;\
  \}\
  .footer-links a \{\
    font-family: 'Space Mono', monospace;\
    font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase;\
    color: var(--muted); text-decoration: none;\
    transition: color 0.2s;\
  \}\
  .footer-links a:hover \{ color: var(--accent); \}\
\
  /* \uc0\u9472 \u9472 \u9472  CART DRAWER \u9472 \u9472 \u9472  */\
  .cart-drawer \{\
    position: fixed; top: 0; right: -420px; width: 420px; height: 100vh;\
    background: var(--ink); border-left: 1px solid var(--border);\
    z-index: 200; transition: right 0.4s cubic-bezier(0.16,1,0.3,1);\
    display: flex; flex-direction: column;\
    padding: 2rem;\
    overflow-y: auto;\
  \}\
  .cart-drawer.open \{ right: 0; \}\
  .cart-overlay \{\
    position: fixed; inset: 0; background: rgba(0,0,0,0.7);\
    z-index: 199; opacity: 0; pointer-events: none;\
    transition: opacity 0.4s;\
    backdrop-filter: blur(4px);\
  \}\
  .cart-overlay.open \{ opacity: 1; pointer-events: all; \}\
  .cart-header \{\
    display: flex; justify-content: space-between; align-items: center;\
    margin-bottom: 2rem;\
    padding-bottom: 1.5rem;\
    border-bottom: 1px solid var(--border);\
  \}\
  .cart-title \{\
    font-family: 'Cormorant Garamond', serif;\
    font-size: 1.5rem; font-weight: 300;\
  \}\
  .cart-close \{\
    background: none; border: none; color: var(--muted);\
    font-size: 1.2rem; cursor: pointer;\
    transition: color 0.2s;\
  \}\
  .cart-close:hover \{ color: var(--cream); \}\
  .cart-empty \{\
    flex: 1; display: flex; flex-direction: column;\
    align-items: center; justify-content: center; gap: 1rem;\
    color: var(--muted);\
    font-family: 'Cormorant Garamond', serif;\
    font-size: 1.1rem; font-style: italic;\
  \}\
  .cart-items \{ flex: 1; \}\
  .cart-item \{\
    display: flex; gap: 1rem; padding: 1rem 0;\
    border-bottom: 1px solid var(--border);\
  \}\
  .cart-item-img \{\
    width: 70px; height: 70px; flex-shrink: 0;\
    display: flex; align-items: center; justify-content: center;\
    font-size: 0.7rem; color: var(--muted); font-style: italic;\
    font-family: 'Cormorant Garamond', serif;\
  \}\
  .cart-item-info \{ flex: 1; \}\
  .cart-item-name \{\
    font-family: 'Cormorant Garamond', serif; font-size: 0.95rem;\
  \}\
  .cart-item-artist \{\
    font-family: 'Space Mono', monospace; font-size: 0.55rem;\
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);\
    margin-top: 0.2rem;\
  \}\
  .cart-item-price \{\
    font-family: 'Space Mono', monospace; font-size: 0.7rem;\
    color: var(--muted); margin-top: 0.5rem;\
  \}\
  .cart-item-remove \{\
    background: none; border: none; color: var(--muted);\
    cursor: pointer; font-size: 0.8rem; align-self: flex-start;\
    transition: color 0.2s;\
  \}\
  .cart-item-remove:hover \{ color: var(--accent); \}\
  .cart-footer \{\
    padding-top: 1.5rem; border-top: 1px solid var(--border);\
  \}\
  .cart-total \{\
    display: flex; justify-content: space-between;\
    font-family: 'Space Mono', monospace; font-size: 0.8rem;\
    margin-bottom: 1.5rem;\
  \}\
  .cart-total-price \{ color: var(--accent); \}\
  .cart-checkout \{\
    width: 100%;\
    background: var(--accent); color: var(--black);\
    font-family: 'Space Mono', monospace;\
    font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;\
    padding: 1rem; border: none; cursor: pointer;\
    transition: opacity 0.2s;\
  \}\
  .cart-checkout:hover \{ opacity: 0.85; \}\
\
  /* \uc0\u9472 \u9472 \u9472  ANIMATIONS \u9472 \u9472 \u9472  */\
  @keyframes fadeUp \{\
    from \{ opacity: 0; transform: translateY(20px); \}\
    to   \{ opacity: 1; transform: translateY(0); \}\
  \}\
  @keyframes fadeIn \{\
    from \{ opacity: 0; \}\
    to   \{ opacity: 1; \}\
  \}\
  @keyframes spin \{\
    from \{ transform: rotate(0deg); \}\
    to   \{ transform: rotate(360deg); \}\
  \}\
  @keyframes marquee \{\
    from \{ transform: translateX(0); \}\
    to   \{ transform: translateX(-50%); \}\
  \}\
  @keyframes float \{\
    0%, 100% \{ transform: translateX(-50%) translateY(0); \}\
    50%       \{ transform: translateX(-50%) translateY(-8px); \}\
  \}\
\
  /* \uc0\u9472 \u9472 \u9472  SCROLL REVEAL \u9472 \u9472 \u9472  */\
  .reveal \{\
    opacity: 0; transform: translateY(28px);\
    transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1),\
                transform 0.7s cubic-bezier(0.16,1,0.3,1);\
  \}\
  .reveal.visible \{ opacity: 1; transform: translateY(0); \}\
\
  /* \uc0\u9472 \u9472 \u9472  MOBILE \u9472 \u9472 \u9472  */\
  @media (max-width: 900px) \{\
    #hero \{ grid-template-columns: 1fr; \}\
    .hero-right \{ display: none; \}\
    .hero-left \{ padding: 7rem 2rem 4rem; \}\
    #about \{ grid-template-columns: 1fr; gap: 3rem; padding: 4rem 2rem; \}\
    .about-visual \{ height: 280px; \}\
    #artists \{ padding: 4rem 1.5rem; \}\
    .artists-grid \{ grid-template-columns: 1fr; \}\
    #shop \{ padding: 4rem 1.5rem; \}\
    .shop-grid \{ grid-template-columns: repeat(2, 1fr); \}\
    #story \{ padding: 4rem 2rem; \}\
    .story-grid \{ grid-template-columns: 1fr; gap: 2rem; \}\
    #contact \{ grid-template-columns: 1fr; gap: 3rem; padding: 4rem 2rem; \}\
    footer \{ flex-direction: column; gap: 1.5rem; padding: 2rem; text-align: center; \}\
    .nav-links \{ display: none; \}\
    nav \{ padding: 1rem 1.5rem; \}\
    .cart-drawer \{ width: 100%; right: -100%; \}\
  \}\
</style>\
</head>\
